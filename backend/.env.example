DOCUMIND_DATA_DIR=data
DOCUMIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DOCUMIND_MAX_UPLOAD_MB=20
DOCUMIND_MAX_PDF_PAGES=500
DOCUMIND_CHUNK_SIZE=800
DOCUMIND_CHUNK_OVERLAP=120
DOCUMIND_EMBEDDING_BATCH_SIZE=16
DOCUMIND_SEARCH_TOP_K=5
DOCUMIND_OFFLINE=false
# DOCUMIND_MODEL_CACHE_DIR=data/models
DOCUMIND_LLM_MODEL=google/flan-t5-base
DOCUMIND_LLM_MAX_NEW_TOKENS=48
DOCUMIND_LLM_TIMEOUT_SECONDS=90
DOCUMIND_LLM_CPU_THREADS=4
DOCUMIND_CHAT_MIN_SIMILARITY=0.30
